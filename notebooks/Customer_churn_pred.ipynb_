on":{"type":"dataframe","variable_name":"cm_ini_df","summary":"{\n  \"name\": \"cm_ini_df\",\n  \"rows\": 3,\n  \"fields\": [\n    {\n      \"column\": \"ACTIVE\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 2575,\n        \"min\": 7,\n        \"max\": 4845,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          4845,\n          894,\n          7\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"AT-RISK\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 1528,\n        \"min\": 12,\n        \"max\": 2958,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          2958,\n          2193,\n          12\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"CHURNED\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0,\n        \"min\": 0,\n        \"max\": 1,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          0,\n          1\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{},"execution_count":60}]},{"cell_type":"markdown","source":["Model performs better now, but it still handles AT-RISK and especially CHURNED clients poorly, giving lots of false alarms for active clients at the same time. At this moment idea to make **two binary classifiers** pops up. The first one will classify client as ACTIVE(0) VS NON-ACTIVE(1),  and the second will classify NON-ACTIVE clients as AT-RISK(0) VS CHURN(1)"],"metadata":{"id":"WLGiZiMiGg6d"}},{"cell_type":"markdown","source":["Model 1: ACTIVE(0), NON-ACTIVE(1)"],"metadata":{"id":"bqayi8iYHmUe"}},{"cell_type":"code","source":["train_set_bin = train_set.copy()\n","train_set_bin['is_not_active'] = train_set_bin['target'].apply(lambda x: 1 if x != 'ACTIVE' else 0)"],"metadata":{"id":"S_q_gjlXNHA9"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["X_temp_bin = train_set_bin.drop(columns=['target', 'is_not_active'])\n","y_temp_bin = train_set_bin['is_not_active']"],"metadata":{"id":"ftpfuQC9Om45"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","X_train_bin, X_val_bin, y_train_bin, y_val_bin = train_test_split(X_temp_bin, y_temp_bin, test_size=0.15, stratify=y_temp_bin, random_state=42)"],"metadata":{"id":"x4pjR72MPoyi"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["neg_count = (y_train_bin == 0).sum()\n","pos_count = (y_train_bin == 1).sum()\n","weight = neg_count / pos_count\n","\n","model_bin = XGBClassifier(\n","    objective=\"binary:logistic\",\n","    eval_metric=\"aucpr\",\n","\n","    n_estimators=1000,\n","    early_stopping_rounds=80,\n","    learning_rate=0.05,\n","\n","    max_depth=6,\n","    min_child_weight=3,\n","\n","    subsample=0.8,\n","    colsample_bytree=0.8,\n","\n","    scale_pos_weight=weight,\n","\n","    random_state=42\n",")\n","\n","model_bin.fit(\n","    X_train_bin, y_train_bin,\n","    eval_set=[(X_train_bin, y_train_bin), (X_val_bin, y_val_bin)],\n","    verbose=True\n",")\n","\n","print(f\"Stopped at iteration: {model_bin.best_iteration}\")\n","print(f\"Best aucpr on val: {model_bin.best_score}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"YlUe2ELsWtR8","executionInfo":{"status":"ok","timestamp":1785974767421,"user_tz":-120,"elapsed":16443,"user":{"displayName":"соня костенко","userId":"08101190354278409981"}},"outputId":"4c342919-7e2f-4d35-c1bb-cedb25b21914"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["[0]\tvalidation_0-aucpr:0.46250\tvalidation_1-aucpr:0.45237\n","[1]\tvalidation_0-aucpr:0.47091\tvalidation_1-aucpr:0.46368\n","[2]\tvalidation_0-aucpr:0.47337\tvalidation_1-aucpr:0.46603\n","[3]\tvalidation_0-aucpr:0.47408\tvalidation_1-aucpr:0.46760\n","[4]\tvalidation_0-aucpr:0.47482\tvalidation_1-aucpr:0.46738\