ebooks/data_table.ipynb>data table notebook</a>'\n","          + ' to learn more about interactive tables.';\n","        element.innerHTML = '';\n","        dataTable['output_type'] = 'display_data';\n","        await google.colab.output.renderOutput(dataTable, element);\n","        const docLink = document.createElement('div');\n","        docLink.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    </script>\n","  </div>\n","\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe","variable_name":"out","summary":"{\n  \"name\": \"out\",\n  \"rows\": 18184,\n  \"fields\": [\n    {\n      \"column\": \"customer_id\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 28978,\n        \"min\": 6,\n        \"max\": 99994,\n        \"num_unique_values\": 18184,\n        \"samples\": [\n          16533,\n          42013,\n          45001\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"segment\",\n      \"properties\": {\n        \"dtype\": \"category\",\n        \"num_unique_values\": 3,\n        \"samples\": [\n          \"ACTIVE\",\n          \"NON-ACTIVE\",\n          \"LOW-RISK AND LOW-VALUE\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"offer_score\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.5812832083350191,\n        \"min\": 0.0,\n        \"max\": 1.8969295024871826,\n        \"num_unique_values\": 13055,\n        \"samples\": [\n          1.1293033361434937,\n          1.1734106540679932,\n          1.3954684734344482\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"churn_prob\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.1955546943722485,\n        \"min\": 0.0,\n        \"max\": 0.7705817818641663,\n        \"num_unique_values\": 8200,\n        \"samples\": [\n          0.2198820561170578,\n          0.13303324580192566,\n          0.6444920301437378\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"active_prob\",\n      \"properties\": {\n        \"dtype\": \"float32\",\n        \"num_unique_values\": 17693,\n        \"samples\": [\n          0.4353088140487671,\n          0.47613030672073364,\n          0.9164053201675415\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{},"execution_count":23}]},{"cell_type":"markdown","source":["Normal confusion matrix\n","\n","It is clear that model's performance is not really good. However, the big amount of NON-ACTIVE clients is found. It leaves us with many false positives, though the model is not classyfying everyone as NON-ACTIVE, finding risk clients well at the same time. Keeping that in mind, we can either try to improve features or data quality and its amount\n","\n"],"metadata":{"id":"183-W7nnxN2R"}},{"cell_type":"code","source":["def evaluate_model_A_treshold(test_df, p_A, threshold=0.35):\n","    true = (test_df[\"target\"] != \"ACTIVE\").astype(int)\n","    pred = (p_A >= threshold).astype(int)\n","    cm = confusion_matrix(true, pred, labels=[0, 1])\n","    return cm\n"],"metadata":{"id":"J9PxMTMIuGj9","executionInfo":{"status":"ok","timestamp":1786365695217,"user_tz":-120,"elapsed":15,"user":{"displayName":"соня костенко","userId":"08101190354278409981"}}},"execution_count":62,"outputs":[]},{"cell_type":"code","source":["cm_1 = evaluate_model_A_treshold(y_test, 1 - out[\"active_prob\"], threshold=0.35)\n","cm_1_df = pd.DataFrame(cm_1, index=[\"Actual Active\", \"Actual Non-active\"], columns=[\"Predicted Active\", \"Predicted Non-active\"])\n","cm_1_df"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":112},"id":"qVmYAVqQwd9i","executionInfo":{"status":"ok","timestamp":1786365697560,"user_tz":-120,"elapsed":40,"user":{"displayName":"соня костенко","userId":"08101190354278409981"}},"outputId":"d3ef2baa-1821-4d91-b461-f1bc1470c2ff"},"execution_count":63,"outputs":[{"output_type":"execute_result","data":{"text/plain":["                   Predicted Active  Predicted Non-active\n","Actual Active                  4374                  8634\n","Actual Non-active               217                  4959"],"text/html":["\n","  <div id=\"df-018f7402-d574-43a9-84cf-4a838dd12b6e\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>Predicted Active</th>\n","      <th>Predicted Non-active</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>Actual Active</th>\n","      <td>4374</td>\n","      <td>8634</td>\n","    </tr>\n","    <tr>\n","      <th>Actual Non-active</th>\n","      <td>217</td>\n","      <td>4959</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>\n","    <div class=\"colab-df-buttons\">\n","\n","  <div class=\"colab-df-container\">\n","    <button class=\"colab-df-convert\" onclick=\"convertToInteractive('df-018f7402-d574-43a9-84cf-4a838dd12b6e')\"\n","            title=\"Convert this dataframe to an interactive table.\"\n","            style=\"display:none;\">\n","\n","  <svg xmlns=\"http://www.w3.org/2000/svg\" height=\"24px\" viewBox=\"0 -960 960 960\">\n","    <path d=\"M120-120v-720h720v720H120Zm60-500h600v-160H180v160Zm220 220h160v-160H400v160Zm0 220h160v-160H400v160ZM180-400h160v-160H180v160Zm440 0h160v-160H620v160ZM180-180h160v-160H180v160Zm44