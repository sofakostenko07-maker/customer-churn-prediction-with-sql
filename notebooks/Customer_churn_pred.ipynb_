{"cell_type":"code","source":["def evaluate_model_A(test_df, out_df):\n","    seg = out_df[\"segment\"].copy()\n","    seg = seg.replace({\"LOW-RISK AND LOW-VALUE\": \"ACTIVE\"})\n","\n","    true = test_df[\"target\"].replace({\n","        \"ACTIVE\": \"ACTIVE\",\n","        \"AT-RISK\": \"NON-ACTIVE\",\n","        \"CHURNED\": \"NON-ACTIVE\"\n","    })\n","\n","    cm = confusion_matrix(true, seg, labels=[\"ACTIVE\", \"NON-ACTIVE\"])\n","    return cm\n"],"metadata":{"id":"ZGyes6RctRB0","executionInfo":{"status":"ok","timestamp":1786365641722,"user_tz":-120,"elapsed":2,"user":{"displayName":"соня костенко","userId":"08101190354278409981"}}},"execution_count":58,"outputs":[]},{"cell_type":"code","source":["cm = evaluate_model_A(y_test, out)\n","cm_df = pd.DataFrame(cm, index=[\"Actual Active\", \"Actual Non-active\"], columns=[\"Predicted Active\", \"Predicted Non-active\"])\n","cm_df"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":112},"id":"0py8h1HttdkV","executionInfo":{"status":"ok","timestamp":1786365786632,"user_tz":-120,"elapsed":135,"user":{"displayName":"соня костенко","userId":"08101190354278409981"}},"outputId":"82e304bd-06e0-429b-b03c-f110d0963724"},"execution_count":67,"outputs":[{"output_type":"execute_result","data":{"text/plain":["                   Predicted Active  Predicted Non-active\n","Actual Active                  4631                  8377\n","Actual Non-active               287                  4889"],"text/html":["\n","  <div id=\"df-7e041c01-f3fe-4e14-be57-7fee18156100\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","    