;\n","      }\n","      })();\n","    </script>\n","  </div>\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe","variable_name":"shap_importance","summary":"{\n  \"name\": \"shap_importance\",\n  \"rows\": 109,\n  \"fields\": [\n    {\n      \"column\": \"feature\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 109,\n        \"samples\": [\n          \"unsuccessful_orders_count_90d\",\n          \"sessions_to_succ_orders_180days\",\n          \"avg_session_interval\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"importance\",\n      \"properties\": {\n        \"dtype\": \"float32\",\n        \"num_unique_values\": 109,\n        \"samples\": [\n          0.003574608825147152,\n          0.017465095967054367,\n          0.050810642540454865\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{},"execution_count":45}]},{"cell_type":"markdown","source":["SHAP confirmed that features referring to category items returns , as well as gender feature are not really important and we can drop them and see if it affected the performance in a bad way. Other features are preserved even if they have occasional low SHAP values, since they describe client's behaviour. I also thought category features other than items returned were to be unimportant, yet it turns out the model uses them, so i don't risk."],"metadata":{"id":"MjGiyGpuJV3R"}},{"cell_type":"markdown","source":["Model B: AT-RISK(0), CHURNED(1)"],"metadata":{"id":"rixohpfFJPZ5"}},{"cell_type":"code","source":["train_set_risk_churn = train_set.copy()\n","train_set_risk_churn = train_set_risk_churn[train_set_risk_churn['target'] != 'ACTIVE']\n","train_set_risk_churn['is_churn'] = train_set_risk_churn['target'].apply(lambda x: 1 if x == 'CHURNED' else 0)"],"metadata":{"id":"FkLbGZvrSexJ"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["X_risk_churn = train_set_risk_churn.drop(columns=['target', 'is_churn'])\n","y_risk_churn = train_set_risk_churn['is_churn']"],"metadata":{"id":"AbasNpMQTtOx"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["X_risk_churn_train, X_risk_churn_val, y_risk_churn_train, y_risk_churn_val = train_test_split(X_risk_churn, y_risk_churn, test_size=0.15, stratify=y_risk_churn, random_state=42)"],"metadata":{"id":"YkilXNzmTfCI"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["neg_count = (y_risk_churn_train == 0).sum()\n","pos_count = (y_risk_churn_train == 1).sum()\n","weight = neg_count / pos_count\n","\n","model_churn_risk = XGBClassifier(\n","    objective=\"binary:logistic\",\n","    eval_metric=\"aucpr\",\n","\n","    n_estimators=1000,\n","    early_stopping_rounds=40,\n","    learning_rate=0.05,\n","\n","    max_depth=5,\n","    min_child_weight=3,\n","\n","    subsample=0.8,\n","    colsample_bytree=0.8,\n","    scale_pos_weight=weight,\n","\n","    random_state=42\n",")\n","\n","model_churn_risk.fit(\n","    X_risk_churn_train, y_risk_churn_train,\n","    eval_set=[(X_risk_churn_train, y_risk_churn_train), (X_risk_churn_val, y_risk_churn_val)],\n","    verbose=True\n",")\n","\n","print(f\"Stopped at iteration: {model_churn_risk.best_iteration}\")\n","print(f\"Best aucpr on val: {model_churn_risk.best_score}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"wm9-1IotUkR9","executionInfo":{"status":"ok","timestamp":1785974782538,"user_tz":-120,"elapsed":2787,"user":{"displayName":"соня костенко","userId":"08101190354278409981"}},"outputId":"c07bdab0-b713-45d7-a420-d3e9ff818d8b"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["[0]\tvalidation_0-aucpr:0.03415\tvalidation_1-aucpr:0.01525\n","[1]\tvalidation_0-aucpr:0.05059\tvalidation_1-aucpr:0.01455\n","[2]\tvalidation_0-aucpr:0.07315\tvalidation_1-aucpr:0.01801\